# Telegram
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
OWNER_USER_ID=
OWNER_NAME=

# LLM
OPENROUTER_API_KEYS=
GROQ_API_KEYS=

# Skills
TAVILY_API_KEY=

# NOTE: no SUDO_PASSWORD here by design. Rubedo 5.0 replaces the
# password-in-.env approach with NOPASSWD sudoers entries scoped to a
# specific, reviewed command allowlist (see techspec, stage 0 / §10),
# instead of storing a plaintext password for automated sudo use.

# More variables will be added here as each rework stage lands
# (Postgres connection, session/zone config, etc.) — this file grows
# with the codebase, never carries real values.
