# Telegram
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
OWNER_USER_ID=
OWNER_NAME=

# LLM
OPENROUTER_API_KEYS=
GROQ_API_KEYS=

# Skills
TAVILY_API_KEY=

# NOTE: no SUDO_PASSWORD here by design. It moves to an encrypted
# per-host credential table instead (techspec §1.6, not built yet) —
# run_sudo/system_update are stubbed until that lands. See stage 0/§10.

# Stop-phrase / resume-phrase (§15) — both empty = feature inert.
STOP_PHRASE=
RESUME_PHRASE=

# Server (§1.2) — SSH, key-based auth only, no password.
SERVER_HOST=
SERVER_USER=
SERVER_SSH_KEY=

# SpotRent (production bot, lives on the server — 4.12)
SPOTRENT_PYTHON=
SPOTRENT_LAUNCHER=
SPOTRENT_CWD=

# More variables will be added here as each rework stage lands
# (Postgres connection, session config, etc.) — this file grows with
# the codebase, never carries real values.
