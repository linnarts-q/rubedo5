# Telegram
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
OWNER_USER_ID=
OWNER_NAME=

# LLM
OPENROUTER_API_KEYS=
GROQ_API_KEYS=

# Memory (Postgres, stage 1.5) — requires pgvector/pg_trgm-capable
# Postgres 13+; run `python -c "from memory.db import init_db; init_db()"`
# once to create the schema.
DATABASE_URL=postgresql://rubedo:CHANGE_ME@localhost:5432/rubedo5

# Skills
TAVILY_API_KEY=

# NOTE: no SUDO_PASSWORD here by design (see stage 0/§10). sudo
# passwords live encrypted in the DB instead (§1.6) — set them with
# `python scripts/set_credential.py <local|server>` on the machine
# itself, never here. CREDENTIALS_KEY below is only the decryption
# key, not a password:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=

# Stop-phrase / resume-phrase (§15) — both empty = feature inert.
STOP_PHRASE=
RESUME_PHRASE=

# Server (§1.2) — SSH, key-based auth only, no password.
SERVER_HOST=
SERVER_USER=
SERVER_SSH_KEY=

# SpotRent (production bot, lives on the server — 4.12)
SPOTRENT_PYTHON=
SPOTRENT_LAUNCHER=
SPOTRENT_CWD=

# PR-flow (stage 6) — code changes go through a branch + PR, not a
# direct file write. GITHUB_TOKEN needs repo contents + pull-requests
# write scope. REPO_PATH/REPO_FULL_NAME are the defaults used when
# propose_code_change targets "self" (her own codebase).
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
REPO_PATH=
REPO_FULL_NAME=

# Display (§19, stage 8) — optional second process (launcher.py),
# a pygame window/avatar on the mini-PC's own screen. Off by default.
ENABLE_DISPLAY=0
DISPLAY_W=800
DISPLAY_H=1280

# More variables will be added here as each rework stage lands
# (Postgres connection, session config, etc.) — this file grows with
# the codebase, never carries real values.
